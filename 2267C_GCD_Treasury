#include <bits/stdc++.h>
using namespace std;

void solve()
{
    int n, x;
    cin >> n >> x;

    vector<int> a(n);

    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    // Find distinct prime factors of x
    vector<int> primes;

    int temp = x;

    for(int p = 2; p * p <= temp; p++)
    {
        if(temp % p == 0)
        {
            primes.push_back(p);

            while(temp % p == 0)
            {
                temp /= p;
            }
        }
    }

    if(temp > 1)
    {
        primes.push_back(temp);
    }

    long long ans = 0;

    // Try each prime divisor of x
    for(int p : primes)
    {
        long long sum = 0;

        for(int val : a)
        {
            if(val % p == 0)
            {
                sum += val;
            }
        }

        ans = max(ans, sum);
    }

    cout << ans << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while(t--)
    {
        solve();
    }

    return 0;
}