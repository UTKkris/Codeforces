#include<bits/stdc++.h>

using namespace std;

void solve(){
    int n ;
    cin >>n;
    vector<int>a(n);
    for(int i =0;i<n;i++)
    {
        cin >> a[i];
    }
    bool found = false;
    for(int i =0;i<n;i++)
    {
        for(int j = 0;j<n;j++)
        {
            if(gcd(a[j],a[i]) <=2)
            {
                found = true;
                break;
            }
        }
    }
    if(found)
    {
        cout << "YES" << "\n";
    }
    else{
        cout << "NO" << "\n";
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while(t--){
        solve();
    }
    return 0;
}