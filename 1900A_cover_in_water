#include<iostream>
#include<bits/stdc++.h>

using namespace std;

void solve(){
    int n;
    string s;
    cin >> n;
    cin >> s;
    int currEmpty = 0;
    int maxEmpty = 0;
    int empty =0;

for(int i = 0; i < n; i++)
{
    if(s[i] == '.')
    {
        empty++;
        currEmpty++;
        maxEmpty = max(maxEmpty, currEmpty);
    }
    else
    {
        currEmpty = 0;
    }
}
    if(maxEmpty >=3)
    {
        cout << "2" << "\n";
    }
    else{
        cout << empty << "\n";
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >>t;
    while(t--)
    {
        solve();
    }
    return 0;
}